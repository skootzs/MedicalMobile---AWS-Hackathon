# WORKER_ID=
# LEASE_SECONDS=900
# BUILD_TIMEOUT_SECONDS=600
# VERIFIER_DIR=     # built by scripts/build-verifier.sh, with no node_modules
# TEMPLATE_DIR=      # templates/cht-base from the same COMPILER_COMMIT checkout
# VERIFIER_COMMIT=e9f70f6
# RUNNER_WORK_DIR=   # per-attempt scratch space on the host
# MAX_RECEIVE_COUNT=3

# MODE=aws  # or: local
