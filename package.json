{
  "name": "cht-nocode",
  "private": true,
  "engines": { "node": ">=22.18" },
  "workspaces": [
    "packages/compiler",
    "packages/schema",
    "packages/evaluator",
    "packages/checker",
    "packages/drafter",
    "packages/orchestrator",
    "packages/intake",
    "packages/ui",
    "packages/verification",
    "packages/synth",
    "runner"
  ],
  "scripts": {
    "start": "npm run start -w packages/intake",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
