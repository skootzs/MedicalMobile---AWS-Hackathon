{
  "name": "@cht-nocode/runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/sync-contract.mjs",
    "sync-contract": "node scripts/sync-contract.mjs",
    "start": "node src/main.ts",
    "typecheck": "npm run sync-contract && tsc -p tsconfig.json",
    "test": "npm run sync-contract && node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "~5.9.3"
  }
}
