{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cht-nocode/verification/verification-report.schema.json",
  "title": "VerificationReport",
  "description": "Output of one synthetic-patient verification run against one built CHT configuration directory. Mirrors src/report.ts. passed and each case status are computed by the report builder, never set by hand. Runner exit codes: 0 passed, 1 verification failed with a valid report, 2 runner error with no valid report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "packageHash",
    "generatedAt",
    "asOf",
    "evaluator",
    "passed",
    "coverageComplete",
    "toolVersions",
    "run",
    "references",
    "compileArtifactHash",
    "testedDirHash",
    "patientSetHash",
    "goldenCasesHash",
    "integrityChecks",
    "coverage",
    "cases",
    "disagreements"
  ],
  "properties": {
    "schemaVersion": { "const": "2.3.0" },
    "version": { "const": "2.3.0" },
    "packageHash": { "type": ["string", "null"], "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "asOf": { "type": "string", "minLength": 1 },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "reason", "source", "root", "evaluatorHash", "pythonVersion", "jsonschemaVersion", "logicModelSource", "asOf"],
      "properties": {
        "used": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "source": { "enum": ["env", "repo", "vendored-zip-unpinned", null] },
        "root": { "type": ["string", "null"] },
        "evaluatorHash": { "type": ["string", "null"] },
        "pythonVersion": { "type": ["string", "null"] },
        "jsonschemaVersion": { "type": ["string", "null"] },
        "logicModelSource": { "enum": ["LOGIC_MODEL_FILE", "/in/logic.json", "CHT_CONFIG_DIR", null] },
        "asOf": { "type": "string", "minLength": 1 }
      }
    },
    "passed": { "type": "boolean" },
    "coverageComplete": { "type": "boolean" },
    "toolVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "chtConf", "chtConfTestHarness", "chromiumRevision", "python"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "chtConf": { "type": "string", "minLength": 1 },
        "chtConfTestHarness": { "type": "string", "minLength": 1 },
        "chromiumRevision": { "type": "string", "minLength": 1 },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "tz", "seed", "fixedClock"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tz": { "type": "string", "minLength": 1 },
        "seed": { "type": ["string", "null"] },
        "fixedClock": { "type": "string", "minLength": 1 }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "logicModelHash", "revision", "clinicalApprovalId", "compilationJobId", "packageHash", "expectedCompileArtifactHash"],
      "properties": {
        "snapshotId": { "type": ["string", "null"], "minLength": 1 },
        "logicModelHash": { "type": ["string", "null"], "minLength": 1 },
        "revision": { "type": ["string", "null"], "minLength": 1 },
        "clinicalApprovalId": { "type": ["string", "null"], "minLength": 1 },
        "compilationJobId": { "type": ["string", "null"], "minLength": 1 },
        "packageHash": { "type": ["string", "null"], "minLength": 1 },
        "expectedCompileArtifactHash": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "compileArtifactHash": { "$ref": "#/$defs/sha256" },
    "testedDirHash": { "$ref": "#/$defs/sha256" },
    "patientSetHash": { "$ref": "#/$defs/sha256" },
    "goldenCasesHash": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "integrityChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/integrityCheck" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "branchSource",
        "sampleWarning",
        "totalBranches",
        "coveredBranches",
        "coveredBranchIds",
        "coveredViaBlockedSubmission",
        "uncoveredBranchIds",
        "uncoveredBranches"
      ],
      "properties": {
        "method": { "const": "observed-outcome" },
        "branchSource": { "enum": ["manifest", "sample"] },
        "sampleWarning": { "type": ["string", "null"], "minLength": 1 },
        "totalBranches": { "type": "integer", "minimum": 0 },
        "coveredBranches": { "type": "integer", "minimum": 0 },
        "coveredBranchIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "coveredViaBlockedSubmission": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "uncoveredBranchIds": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "uncoveredBranches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    },
    "disagreements": {
      "type": "array",
      "items": { "$ref": "#/$defs/disagreement" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrityCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ok", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "detail": { "type": "string" }
      }
    },
    "expectedResult": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["expected", "status"],
      "properties": {
        "expected": {},
        "status": { "enum": ["pass", "fail"] },
        "usedDayOnly": { "type": "boolean" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "branchId",
        "kind",
        "actual",
        "golden",
        "evaluator",
        "status",
        "failureDetail",
        "harnessOutput"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "input": {},
        "branchId": { "type": ["string", "null"] },
        "kind": { "enum": ["branch", "boundary", "exceptional"] },
        "actual": {},
        "golden": { "$ref": "#/$defs/expectedResult" },
        "evaluator": { "$ref": "#/$defs/expectedResult" },
        "status": { "enum": ["pass", "fail", "disagree", "error"] },
        "matchedBy": { "enum": ["form-blocked-submission"] },
        "blockedSubmission": { "type": "boolean" },
        "expectedSource": { "enum": ["evaluator", "golden", "both"] },
        "matchedRows": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "comparedFields": { "type": "array", "items": { "type": "string" } },
        "failureDetail": { "type": ["string", "null"] },
        "harnessOutput": { "type": ["string", "null"] }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "kind", "actual", "golden", "evaluator", "detail"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["golden-vs-evaluator", "actual-vs-golden", "actual-vs-evaluator"] },
        "actual": {},
        "golden": {},
        "evaluator": {},
        "detail": { "type": "string" }
      }
    }
  }
}
